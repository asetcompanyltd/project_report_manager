# Local dev default: a SQLite file next to the project (zero config).
# For Turso in production, set this to your libsql:// URL instead.
DATABASE_URL=file:./local.db

# Only needed when DATABASE_URL points at a real Turso database.
DATABASE_AUTH_TOKEN=

# Secret used to sign session JWTs. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=
